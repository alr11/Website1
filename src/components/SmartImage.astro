---
/**
 * SmartImage
 * ---------------------------------------------------------------------------
 * Renders a real <img> if the file exists in /public, otherwise renders a
 * placeholder block that prints the exact filename you need to drop in.
 *
 * This means the site is fully browsable before you've uploaded anything, and
 * every missing image tells you its own filename. No external/stock images are
 * fetched — the stand-in is drawn locally with CSS.
 *
 * The existence check runs at BUILD time only, so it costs nothing at runtime.
 */
import fs from 'node:fs';
import path from 'node:path';

import { url } from '../lib/url';
interface Props {
  /** Public path, e.g. "/images/packages/flower-wall-1.jpg" */
  src: string;
  alt: string;
  /** CSS aspect-ratio, e.g. "4 / 3". Omit for intrinsic sizing. */
  ratio?: string;
  /** Native lazy loading; pass "eager" for above-the-fold images. */
  loading?: 'lazy' | 'eager';
  class?: string;
  sizes?: string;
}

const {
  src,
  alt,
  ratio = '4 / 3',
  loading = 'lazy',
  class: className = '',
  sizes,
} = Astro.props;

let exists = false;
try {
  exists = fs.existsSync(path.join(process.cwd(), 'public', src));
} catch {
  exists = false;
}

const label = src.replace(/^\/images\//, '');
---

{
  exists ? (
    <img
      src={url(src)}
      alt={alt}
      loading={loading}
      decoding="async"
      sizes={sizes}
      class={`smart-img ${className}`}
      style={ratio ? `aspect-ratio:${ratio}` : undefined}
    />
  ) : (
    <div
      class={`img-ph ${className}`}
      style={ratio ? `aspect-ratio:${ratio}` : undefined}
      role="img"
      aria-label={`Placeholder for ${alt}`}
    >
      <span class="img-ph__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="8.5" cy="9.5" r="1.5" />
          <path d="M21 16l-5-5-4.5 4.5-2-2L3 19" />
        </svg>
      </span>
      <span class="img-ph__name">{label}</span>
      <span class="img-ph__hint">add to /public/images/</span>
    </div>
  )
}

<style>
  .smart-img {
    width: 100%;
    object-fit: cover;
    background: var(--sand);
  }

  .img-ph {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    text-align: center;
    padding: 1rem;
    background:
      repeating-linear-gradient(
        45deg,
        var(--sand),
        var(--sand) 12px,
        #ece5db 12px,
        #ece5db 24px
      );
    border: 1px dashed #c4bab0;
    color: var(--ink-soft);
  }

  .img-ph__icon {
    color: #a99e93;
    line-height: 0;
  }

  .img-ph__name {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--navy);
    word-break: break-all;
    line-height: 1.35;
    max-width: 100%;
  }

  .img-ph__hint {
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a2988d;
  }
</style>
