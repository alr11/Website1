---
import { site } from '../data/site';
import { categories } from '../data/packages';
import SmartImage from './SmartImage.astro';

import { url, stripBase } from '../lib/url';
const path = stripBase(Astro.url.pathname);

const links = [
  { href: '/', label: 'Home' },
  ...categories.map((c) => ({ href: `/${c.slug}`, label: c.title })),
  { href: '/price-list', label: 'Price List' },
  { href: '/contact', label: 'Contact' },
];

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={url("/")}>
      <span class="brand__logo">
        <SmartImage src="/images/logo.png" alt={`${site.name} logo`} ratio="1 / 1" loading="eager" />
      </span>
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__descriptor">{site.descriptor}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Main" data-nav>
      <ul class="nav__list">
        {
          links.map((link) => (
            <li>
              <a
                href={url(link.href)}
                class="nav__link"
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="nav__cta">
          <a class="btn btn--primary" href={url("/contact")}>Enquire</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }

  /* ---------------------------------------------------------------- brand */

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    padding-block: 0.6rem;
    flex-shrink: 0;
  }

  .brand__logo {
    display: block;
    width: 42px;
    flex-shrink: 0;
  }

  .brand__logo :global(.img-ph) {
    padding: 0.15rem;
    border-radius: 50%;
  }

  /* The filename label is noise at this size — the tile alone reads as a slot. */
  .brand__logo :global(.img-ph__name),
  .brand__logo :global(.img-ph__hint) {
    display: none;
  }

  .brand__logo :global(.smart-img) {
    border-radius: 50%;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--navy);
  }

  .brand__descriptor {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teal);
  }

  /* --------------------------------------------------------------- toggle */

  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .nav-toggle__bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 20px;
  }

  .nav-toggle__bars span {
    display: block;
    height: 2px;
    background: var(--navy);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ------------------------------------------------------ nav (mobile 1st) */

  .nav {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--white);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }

  .nav[data-open='true'] {
    display: block;
  }

  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--gutter) 1.25rem;
  }

  .nav__link {
    display: block;
    padding: 0.75rem 0;
    color: var(--navy);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--sand);
  }

  .nav__link[aria-current='page'] {
    color: var(--teal);
    font-weight: 700;
  }

  .nav__cta {
    margin-top: 1rem;
  }

  .nav__cta .btn {
    display: block;
  }

  /* ------------------------------------------------------------- desktop */

  @media (min-width: 1180px) {
    .nav-toggle {
      display: none;
    }

    .nav {
      display: block;
      position: static;
      border: 0;
      box-shadow: none;
      background: transparent;
    }

    .nav__list {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0;
    }

    .nav__link {
      padding: 0.4rem 0.55rem;
      border-bottom: 0;
      font-size: 0.85rem;
      border-radius: 6px;
      white-space: nowrap;
    }

    .nav__link:hover {
      background: var(--teal-wash);
    }

    .nav__cta {
      margin: 0 0 0 0.75rem;
    }

    .nav__cta .btn {
      padding: 0.55rem 1.15rem;
      font-size: 0.88rem;
    }
  }
</style>

<script>
  // The ClientRouter swaps the DOM on navigation, so listeners bound once at
  // load are lost. Bind on astro:page-load, which fires on first load AND
  // after every client-side navigation.
  function initNav() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!toggle || !nav) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.dataset.open = String(open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close on Escape, returning focus to the button.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Reset state if the viewport grows past the desktop breakpoint while open.
    window.matchMedia('(min-width: 1180px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  document.addEventListener('astro:page-load', initNav);
</script>
